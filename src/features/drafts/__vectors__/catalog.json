  "listDrafts": [
    {
      "name": "no filter: every unsent draft, newest change first, equal times by id",
      "net": {
        "online": true,
        "wifi": true,
        "wifiOnlyUploads": false
      },
      "filter": {},
      "expect": [
        ["d-ready", "ready"],
        ["d-queued", "queued"],
        ["d-failed", "failed"],
        ["d-upl", "uploading"],
        ["d-none", "draft"],
        ["d-plan", "draft"],
        ["d-clock2", "needs_credentials"]
      ]
    },
    {
      "name": "contextKeyPrefix 'clock:' matches every clock session and not 'clock-plan:'",
      "net": {
        "online": true,
        "wifi": true,
        "wifiOnlyUploads": false
      },
      "filter": {
        "contextKeyPrefix": "clock:"
      },
      "expect": [
        ["d-queued", "queued"],
        ["d-upl", "uploading"],
        ["d-clock2", "needs_credentials"]
      ]
    },
    {
      "name": "contextKeyPrefix 'clock:' with 'sent' interleaves receipts by updatedAt",
      "net": {
        "online": true,
        "wifi": true,
        "wifiOnlyUploads": false
      },
      "filter": {
        "contextKeyPrefix": "clock:",
        "states": ["queued", "uploading", "needs_credentials", "sent"]
      },
      "expect": [
        ["r-kept", "sent"],
        ["d-queued", "queued"],
        ["r-done", "sent"],
        ["d-upl", "uploading"],
        ["d-clock2", "needs_credentials"]
      ]
    },
    {
      "name": "contextKey matches one place exactly",
      "net": {
        "online": true,
        "wifi": true,
        "wifiOnlyUploads": false
      },
      "filter": {
        "contextKey": "ticket:t-1"
      },
      "expect": [
        ["d-ready", "ready"],
        ["d-failed", "failed"]
      ]
    },
    {
      "name": "contextKind matches the key's kind; a draft without a place matches no place filter",
      "net": {
        "online": true,
        "wifi": true,
        "wifiOnlyUploads": false
      },
      "filter": {
        "contextKind": "clock"
      },
      "expect": [
        ["d-queued", "queued"],
        ["d-upl", "uploading"],
        ["d-clock2", "needs_credentials"]
      ]
    },
    {
      "name": "states ['sent'] lists only receipts, dismissed ones included",
      "net": {
        "online": true,
        "wifi": true,
        "wifiOnlyUploads": false
      },
      "filter": {
        "states": ["sent"]
      },
      "expect": [
        ["r-kept", "sent"],
        ["r-done", "sent"],
        ["r-kept-dismissed", "sent"]
      ]
    },
    {
      "name": "offline: a queued draft is waiting_network, so ['queued'] finds nothing",
      "net": {
        "online": false,
        "wifi": false,
        "wifiOnlyUploads": false
      },
      "filter": {
        "states": ["queued"]
      },
      "expect": []
    },
    {
      "name": "offline: ['waiting_network'] finds the queued draft",
      "net": {
        "online": false,
        "wifi": false,
        "wifiOnlyUploads": false
      },
      "filter": {
        "states": ["waiting_network"]
      },
      "expect": [["d-queued", "waiting_network"]]
    },
    {
      "name": "Wi-Fi only on cellular: the default list shows the queued draft as waiting_network",
      "net": {
        "online": true,
        "wifi": false,
        "wifiOnlyUploads": true
      },
      "filter": {
        "contextKind": "clock"
      },
      "expect": [
        ["d-queued", "waiting_network"],
        ["d-upl", "uploading"],
        ["d-clock2", "needs_credentials"]
      ]
    },
    {
      "name": "an unknown context key matches nothing",
      "net": {
        "online": true,
        "wifi": true,
        "wifiOnlyUploads": false
      },
      "filter": {
        "contextKey": "ticket:none"
      },
      "expect": []
    }
  ],
  "countDrafts": [
    {
      "name": "by contextKey: every unsent draft with a place",
      "net": {
        "online": true,
        "wifi": true,
        "wifiOnlyUploads": false
      },
      "options": {
        "by": "contextKey"
      },
      "expect": {
        "ticket:t-1": 2,
        "clock:e1": 2,
        "clock-plan:e9": 1,
        "clock:e2": 1
      }
    },
    {
      "name": "by contextKind: 'clock' and 'clock-plan' are separate kinds",
      "net": {
        "online": true,
        "wifi": true,
        "wifiOnlyUploads": false
      },
      "options": {
        "by": "contextKind"
      },
      "expect": {
        "ticket": 2,
        "clock": 3,
        "clock-plan": 1
      }
    },
    {
      "name": "attentionOnly by contextKey: failed, and kept receipts not dismissed",
      "net": {
        "online": true,
        "wifi": true,
        "wifiOnlyUploads": false
      },
      "options": {
        "by": "contextKey",
        "attentionOnly": true
      },
      "expect": {
        "ticket:t-1": 1,
        "clock:e2": 1
      }
    },
    {
      "name": "attentionOnly by contextKind",
      "net": {
        "online": true,
        "wifi": true,
        "wifiOnlyUploads": false
      },
      "options": {
        "by": "contextKind",
        "attentionOnly": true
      },
      "expect": {
        "ticket": 1,
        "clock": 1
      }
    },
    {
      "name": "attentionOnly with states ['failed'] leaves the kept receipt out",
      "net": {
        "online": true,
        "wifi": true,
        "wifiOnlyUploads": false
      },
      "options": {
        "by": "contextKey",
        "attentionOnly": true,
        "states": ["failed"]
      },
      "expect": {
        "ticket:t-1": 1
      }
    },
    {
      "name": "states ['sent'] counts receipts",
      "net": {
        "online": true,
        "wifi": true,
        "wifiOnlyUploads": false
      },
      "options": {
        "by": "contextKey",
        "states": ["sent"]
      },
      "expect": {
        "clock:e2": 1,
        "clock:e1": 1,
        "ticket:t-1": 1
      }
    },
    {
      "name": "offline: states ['waiting_network'] counts the queued draft",
      "net": {
        "online": false,
        "wifi": false,
        "wifiOnlyUploads": false
      },
      "options": {
        "by": "contextKind",
        "states": ["waiting_network"]
      },
      "expect": {
        "clock": 1
      }
    },
    {
      "name": "online: states ['waiting_network'] counts nothing",
      "net": {
        "online": true,
        "wifi": true,
        "wifiOnlyUploads": false
      },
      "options": {
        "by": "contextKind",
        "states": ["waiting_network"]
      },
      "expect": {}
    }
  ],
