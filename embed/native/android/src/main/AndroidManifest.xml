<?xml version="1.0" encoding="utf-8"?>
<!--
  PulseKit's library manifest (G2). with-pulsekit-android.js points the generated `pulsekit`
  library at this file in place of expo-brownfield's empty one, and the fused AAR merges it with
  every Pulse dependency's manifest. The host's own manifest merge then applies it.

  - Requests only what Pulse uses. embed/scripts/lib/android-aar.mjs ALLOWED_PERMISSIONS is the
    same list, and package-android.mjs refuses an AAR that asks for more.
  - Removes what Pulse dependencies would otherwise add (AD30, pulse#257): media and storage
    reads beyond Save to Photos, overlays, screen capture, boot receivers and Play's install
    referrer. android-aar.mjs REMOVED_PERMISSIONS is that list.
  - No application-level attributes: allowBackup, cleartext traffic and the app theme are the
    host's.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">

  <!-- A host still installs on a device without a camera or microphone; info() reports it. -->
  <uses-feature android:name="android.hardware.camera" android:required="false" />
  <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
  <uses-feature android:name="android.hardware.microphone" android:required="false" />

  <uses-permission android:name="android.permission.CAMERA" />
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <!-- PulseUploadService: background uploads in a dataSync foreground service. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
  <uses-permission android:name="android.permission.VIBRATE" />
  <!--
    expo-audio's setAudioModeAsync (the recorder's audio focus, the editor's preview) sets the
    AudioManager mode and speaker route, which need it. A normal permission: no prompt, no Play
    declaration. The standalone app has it from the same module.
  -->
  <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
  <!--
    Save to Photos on Android 7-9 only; 10+ writes through MediaStore without it. tools:replace
    caps a dependency's broader request (expo-media-library asks up to API 32).
  -->
  <uses-permission
    android:name="android.permission.WRITE_EXTERNAL_STORAGE"
    android:maxSdkVersion="28"
    tools:replace="android:maxSdkVersion" />

  <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" tools:node="remove" />
  <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" tools:node="remove" />
  <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" tools:node="remove" />
  <uses-permission
    android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
    tools:node="remove" />
  <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" tools:node="remove" />
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" tools:node="remove" />
  <uses-permission
    android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION"
    tools:node="remove" />
  <uses-permission
    android:name="android.permission.RECEIVE_BOOT_COMPLETED"
    tools:node="remove" />
  <!--
    expo-file-system, expo-image, expo-image-picker and expo-media-library ask for it up to API 32.
    Pulse reads no shared storage: imports go through the system picker (a content URI it may
    read), and Save to Photos asks expo-media-library for write-only access.
  -->
  <uses-permission
    android:name="android.permission.READ_EXTERNAL_STORAGE"
    tools:node="remove" />
  <!-- expo-application's Play install-referrer client; Pulse never reads the referrer. -->
  <uses-permission
    android:name="com.google.android.finsky.permission.BIND_GET_INSTALL_REFERRER_SERVICE"
    tools:node="remove" />

  <application>
    <!-- Pulse's screens: full screen over the host, portrait, back owned by Pulse JS (PR4-D). -->
    <activity
      android:name="com.mieweb.pulse.kit.PulseActivity"
      android:exported="false"
      android:theme="@style/Theme.PulseKit"
      android:screenOrientation="portrait"
      android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale"
      android:windowSoftInputMode="adjustResize" />

    <!-- Uploads that continue after Pulse closes, the screen locks or the task is swiped (PR4-E). -->
    <service
      android:name="com.mieweb.pulse.kit.PulseUploadService"
      android:exported="false"
      android:foregroundServiceType="dataSync"
      android:stopWithTask="false" />
  </application>
</manifest>
