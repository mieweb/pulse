# The test hosts keep only their sources here. Everything below is generated by `npm install`,
# `npx cap add/sync` or `cordova prepare` on the owner's machine and never committed.
node_modules/
package-lock.json

# The cap-host contract page's bundle (cap-host/src/contract/build.mjs)
cap-host/www/contract/

# Capacitor's native projects (npx cap add ios / android)
cap-host/ios/
cap-host/android/

# Cordova's platforms and installed plugin copies (cordova prepare)
cordova-host/platforms/
cordova-host/plugins/

# PulseKit's binaries, wherever they land
*.xcframework
*.xcframework.zip
