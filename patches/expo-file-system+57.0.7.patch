+  // Pulse patch: one entry per network attempt URLSession made for this task (a dropped connection
+  // it retried is a second attempt), so the app can log which HTTP version carried the upload.
+  fileprivate func emitMetrics(_ metrics: URLSessionTaskMetrics) {
+    let attempts: [[String: Any]] = metrics.transactionMetrics.map { transaction in
+      var attempt: [String: Any] = [
+        "protocol": transaction.networkProtocolName ?? "unknown",
+        "reusedConnection": transaction.isReusedConnection,
+        "bodyBytesSent": transaction.countOfRequestBodyBytesSent
+      ]
+      if let start = transaction.fetchStartDate, let end = transaction.responseEndDate ?? transaction.requestEndDate {
+        attempt["durationMs"] = Int(end.timeIntervalSince(start) * 1000)
+      }
+      return attempt
+    }
+    let payload: [String: Any] = [
+      "attempts": attempts,
+      "durationMs": Int(metrics.taskInterval.duration * 1000)
+    ]
+    emit(event: "metrics", payload: payload)
+  }
+
